# ============================================================
# KOALA WHATSAPP CRM — variáveis de ambiente
# NUNCA coloque valores reais neste arquivo nem no código.
# Copie para .env.local (dev) e configure os mesmos nomes
# em Vercel > Project Settings > Environment Variables (prod).
# ============================================================

# ---- Supabase ----
# Encontre em: Supabase > Project Settings > API
# Use a nomenclatura NOVA de chaves (publishable/secret), não anon/service_role legada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta — NUNCA exposta ao browser, só em rotas server-side (webhook, cron, admin)
SUPABASE_SECRET_KEY=

# ---- Meta / WhatsApp Cloud API ----
# Meta for Developers > seu App > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Token que você escolhe ao configurar o webhook na Meta (qualquer string forte e secreta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret do Meta App, usado para validar a assinatura HMAC de cada webhook recebido
META_APP_SECRET=

# Versão da Graph API (opcional)
WHATSAPP_GRAPH_VERSION=v23.0

# ---- Bot de qualificação (docs/BOT_FUNIL.md) ----
# Nome na boas-vindas: "Olá! Sou o Piero, da Koala Turismo"
BOT_ATTENDANT_NAME=Piero
# Link do grupo de promoções enviado no fim do roteiro (vazio = não envia)
BOT_PROMO_GROUP_URL=

# ---- Avisos automáticos (docs/AVISOS.md / docs/TEMPLATES_META.md) ----
# Nomes dos templates aprovados na Meta (padrões abaixo)
WA_TEMPLATE_VIAGEM_1_SEMANA=koala_viagem_1_semana
WA_TEMPLATE_PASSAPORTE=koala_passaporte_vencendo
WA_TEMPLATE_VISTO=koala_visto_vencendo
# Teto de mensagens de vencimento por dia
AVISOS_MAX_VENCIMENTOS_POR_DIA=40

# ---- Google Calendar — service account (docs/INTEGRACOES.md) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ---- Trello (docs/INTEGRACOES.md) ----
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
# opcional: IDs de etiquetas separados por vírgula
TRELLO_LABEL_IDS=

# ---- Anthropic (Claude) ----
# console.anthropic.com — billing separado de uma assinatura claude.ai
ANTHROPIC_API_KEY=

# ---- Segurança de rotas internas (cron / jobs) ----
# String secreta usada para autenticar chamadas às rotas /api/cron/* (Vercel Cron e pg_cron do Supabase)
CRON_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
